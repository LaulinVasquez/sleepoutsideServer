PORT=3000
NODE_ENV=development
# Complete URI (credentials must be URL-encoded); used as-is when supplied.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-hostname>/?retryWrites=true&w=majority
# Alternatively, set MONGO_URI to only the Atlas hostname and options.
# These credentials are used only with that hostname-only format.
MONGO_USER=<username>
MONGO_PASSWORD=<password>
MONGO_DATABASE=sleepoutside
